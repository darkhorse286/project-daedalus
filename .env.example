# Project DAEDALUS — Environment Variable Template
# Copy this file to .env and replace all <replace> placeholders before running docker compose up.
# The .env file is excluded from version control via .gitignore (*.env pattern).
# Do NOT commit real credentials to any file in this repository.

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=daedalus
POSTGRES_PASSWORD=<replace>
POSTGRES_DB=daedalus

# ─── RabbitMQ ───────────────────────────────────────────────────────────────────
# Virtual host is the default (/). Queue topology (routing-jobs, routing-jobs-dead-letter)
# is declared in config/rabbitmq/definitions.json and loaded at container startup.
RABBITMQ_DEFAULT_USER=daedalus
RABBITMQ_DEFAULT_PASS=<replace>

# ─── Grafana ─────────────────────────────────────────────────────────────────────
# GRAFANA_PORT: host port for Grafana UI. Must not be 3000 (reserved for web-ui per ADR-014).
# Chosen value: 3001. Change only if 3001 conflicts with another local service.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<replace>
GRAFANA_PORT=3001

# ─── OpenTelemetry Collector ─────────────────────────────────────────────────────
# No secrets required for the collector in this configuration.
# OTLP gRPC receiver: localhost:4317
# OTLP HTTP receiver: localhost:4318
# Prometheus exporter (scraped by Prometheus service): otel-collector:8889 (internal network)
# Health check endpoint: localhost:13133
